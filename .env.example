# ============================================================
#  星星成长记 · 宿主机环境变量模板
#
#  用法：
#      cp .env.example .env      # 然后按需改
#      docker compose up -d      # compose 会自动读取同目录的 .env
#
#  什么时候需要它：
#      只有"服务器上代码用 git 管理、数据放在仓库外面"这个场景需要。
#      本机开发（start-docker.bat）完全不用建 .env，默认值就是对的。
#
#  .env 本身不进 git（见 .gitignore），因为里面的路径只对某台机器成立。
# ============================================================


# ---------------------------------------------------------------- 对外端口
# 宿主机端口，容器里固定 8777。被占用时改成 9000 之类。
KIDS_HOST_PORT=8777


# ---------------------------------------------------------------- 数据位置
# Docker 的坑：这三条路径如果【宿主机上不存在】，
# Docker 不会报错，而是默默建成一个空目录（rules.yaml 那条尤其致命，服务直接起不来）。
# 所以第一次启动前先建好：
#
#     sudo mkdir -p /srv/star-kids/{data,uploads}
#     sudo touch /srv/star-kids/rules.yaml
#     sudo chown -R 1000:1000 /srv/star-kids
#
# 留空或删掉这几行 = 用项目目录下的 ./data ./uploads ./rules.yaml（默认行为）。
#
# KIDS_HOST_DATA=/srv/star-kids/data
# KIDS_HOST_UPLOADS=/srv/star-kids/uploads
# KIDS_HOST_RULES=/srv/star-kids/rules.yaml


# ---------------------------------------------------------------- 反代 / 初始化
# 前面有 nginx / Caddy / Cloudflare Tunnel 时改成 1。
# 不开的话所有访客的 IP 都会被记成 127.0.0.1，
# 登录失败限流按同一个 IP 累加，很容易把全家人锁在外面。
KIDS_PROXY=0

# 0 = 跳过演示数据初始化（只在数据库文件不存在时才有意义）
KIDS_SEED=auto
